    "roundLabel": { "fr": "Manche", "en": "Round" },
    "entry": {
      "kind": "integer",
      "min": 0,
      "allowsNegative": false
    },
    "modifiers": []
  },

  "engine": "generic.sum.v1",

  "end": {
    "conditions": [
      {
        "type": "roundLimit",
        "value": 3,
        "comparison": ">=",
        "scope": "allPlayers",
        "completeRound": true
      }
    ]
  },

  "tieBreak": ["shared"],

  "statsProfiles": ["standard"]
